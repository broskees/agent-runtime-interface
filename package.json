{
  "name": "ari",
  "version": "0.1.0",
  "description": "Provider-neutral runtime contract, host toolkit and drivers for coding agents.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "bin": {
    "ari-driver": "./dist/wire/cli.js"
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "development": "./src/host/index.ts",
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./driver-kit": {
      "development": "./src/driver-kit/index.ts",
      "types": "./dist/driver-kit/index.d.ts",
      "default": "./dist/driver-kit/index.js"
    },
    "./node": {
      "development": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./wire": {
      "development": "./src/wire/index.ts",
      "types": "./dist/wire/index.d.ts",
      "default": "./dist/wire/index.js"
    },
    "./conformance": {
      "development": "./src/conformance/index.ts",
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./effect": {
      "development": "./src/effect/index.ts",
      "types": "./dist/effect/index.d.ts",
      "default": "./dist/effect/index.js"
    },
    "./drivers/*": {
      "development": "./src/drivers/*/index.ts",
      "types": "./dist/drivers/*/index.d.ts",
      "default": "./dist/drivers/*/index.js"
    },
    "./meta/*": {
      "development": "./src/meta/*.ts",
      "types": "./dist/meta/*.d.ts",
      "default": "./dist/meta/*.js"
    },
    "./cli-manifests": {
      "development": "./src/cli-manifests/index.ts",
      "types": "./dist/cli-manifests/index.d.ts",
      "default": "./dist/cli-manifests/index.js"
    },
    "./json-schema/*": "./json-schema/*"
  },
  "scripts": {
    "codegen": "node scripts/codegen.ts && node scripts/codegen-effect.ts",
    "codegen:check": "node scripts/codegen.ts --check",
    "codegen:effect:check": "node scripts/codegen-effect.ts --check",
    "codegen:acp": "node scripts/codegen-acp.ts",
    "codegen:acp:check": "node scripts/codegen-acp.ts --check",
    "build": "node scripts/build.ts",
    "check:rules": "node scripts/check-rules.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:package": "node scripts/check-package.ts",
    "gate": "pnpm run codegen:check && pnpm run codegen:effect:check && pnpm run codegen:acp:check && pnpm run build && pnpm run check:rules && pnpm run typecheck && pnpm run test && pnpm run check:package"
  },
  "dependencies": {},
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@cursor/sdk": "1.0.38",
    "@muse-code/sdk": "1.4.6",
    "@opencode-ai/sdk": "^1.3.15",
    "@opencode/client": "2.0.28",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@cursor/sdk": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    },
    "@muse-code/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "effect": "4.1.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
