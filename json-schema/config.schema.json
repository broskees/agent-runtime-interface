{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.invalid/spec/v1/config.schema.json",
  "title": "ARI config options and runtime policy",
  "description": "Config options are modelled on ACP's session config options. Runtime policy carries one of five runtime modes, or none to keep the harness's own, and one of two interaction modes.",
  "$defs": {
    "ConfigOptionCategory": {
      "anyOf": [
        {
          "enum": [
            "model",
            "reasoning",
            "mode",
            "permission",
            "provider",
            "other"
          ]
        },
        {
          "$ref": "common.schema.json#/$defs/ExtensionName"
        }
      ]
    },
    "ConfigOptionType": {
      "anyOf": [
        {
          "enum": [
            "select",
            "boolean",
            "text",
            "number"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ConfigOptionScope": {
      "anyOf": [
        {
          "enum": [
            "instance",
            "session",
            "thread",
            "turn"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ConfigChangeEffect": {
      "anyOf": [
        {
          "enum": [
            "next_turn",
            "immediate",
            "restart_session",
            "new_thread"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ConfigOptionValue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "ConfigOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ConfigOptionCategory"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ConfigOptionType"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigOptionValue"
          }
        },
        "current": {
          "$ref": "common.schema.json#/$defs/AnyValue"
        },
        "scope": {
          "$ref": "#/$defs/ConfigOptionScope"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of options this one depends on, for example a model select that depends on a provider select."
        },
        "changeEffect": {
          "$ref": "#/$defs/ConfigChangeEffect"
        }
      },
      "required": [
        "id",
        "category",
        "label",
        "type",
        "current",
        "scope",
        "changeEffect"
      ]
    },
    "RuntimeMode": {
      "anyOf": [
        {
          "enum": [
            "read_only",
            "approval_required",
            "auto_accept_edits",
            "auto",
            "full_access"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "InteractionMode": {
      "anyOf": [
        {
          "enum": [
            "default",
            "plan"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "RuntimePolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/RuntimeMode",
          "description": "Leave it out to keep the harness's own mode: the driver sends the harness no permission override, so it applies the user's own configuration for the workspace. The thread's `effectiveMode` then reports what the harness chose."
        },
        "interaction": {
          "$ref": "#/$defs/InteractionMode"
        },
        "cwd": {
          "type": "string"
        },
        "additionalRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native": {
          "$ref": "common.schema.json#/$defs/AnyValue",
          "description": "Opaque provider-native policy passed through unchanged."
        }
      },
      "required": [
        "interaction",
        "cwd"
      ]
    },
    "EffectiveMode": {
      "description": "The mode a thread runs in, as far as the driver knows. `source` says who chose it: `host` when the host named `policy.mode`, `harness` when the host left it out and the harness applied its own. `mode` is the ARI mode the harness's setting maps to, or the vendor's own name when no ARI mode fits; `interaction` is the interaction mode. Each is absent while the driver does not know it: a driver never guesses either.",
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/RuntimeMode"
        },
        "interaction": {
          "$ref": "#/$defs/InteractionMode"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "host",
                "harness"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "source"
      ]
    },
    "SlashCommand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "argumentHint": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Where the command comes from, for example `builtin`, `project` or `user`."
        }
      },
      "required": [
        "name"
      ]
    },
    "Skill": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "ConfigChangePlan": {
      "description": "How a config change would take effect, returned by `planConfigChange` without applying anything.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "apply_next_turn"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "apply_now"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "restart_session"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "new_thread_with_handoff"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "reject"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ]
        }
      ]
    }
  }
}
