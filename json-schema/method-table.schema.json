{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.invalid/spec/v1/method-table.schema.json",
  "title": "ARI method table format",
  "description": "The format of spec/v1/methods.json, which lists every JSON-RPC method of `ari/wire` and maps it to a member of the hand-written TypeScript interfaces. The method table is tooling metadata, not wire data, so its enums are closed.",
  "$ref": "#/$defs/MethodTable",
  "$defs": {
    "SchemaRef": {
      "description": "A reference to a schema definition, relative to spec/v1, for example `session.schema.json#/$defs/StartTurnInput`.",
      "type": "object",
      "properties": {
        "$ref": {
          "type": "string"
        }
      },
      "required": [
        "$ref"
      ]
    },
    "MethodDirection": {
      "description": "Who sends the request or notification. `both`: either side may send it.",
      "enum": [
        "host_to_driver",
        "driver_to_host",
        "both"
      ]
    },
    "MethodKind": {
      "description": "`request`: expects a response. `notification`: no response.",
      "enum": [
        "request",
        "notification"
      ]
    },
    "RuntimeInterface": {
      "enum": [
        "Driver",
        "Instance",
        "Session",
        "HostServices"
      ]
    },
    "MethodStream": {
      "description": "How a streaming member streams. The request's result carries a `streamId`; each item arrives as a `notification` whose params carry the `streamId`; the producer ends the stream with `end`; the consumer may stop it early with `cancel`.",
      "type": "object",
      "properties": {
        "notification": {
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/SchemaRef"
        },
        "end": {
          "type": "string"
        },
        "cancel": {
          "type": "string"
        },
        "startedWhen": {
          "type": "string",
          "description": "When the stream starts, if not always."
        }
      },
      "required": [
        "notification",
        "item",
        "end",
        "cancel"
      ]
    },
    "MethodEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The JSON-RPC method name."
        },
        "direction": {
          "$ref": "#/$defs/MethodDirection"
        },
        "kind": {
          "$ref": "#/$defs/MethodKind"
        },
        "interface": {
          "$ref": "#/$defs/RuntimeInterface"
        },
        "member": {
          "type": "string",
          "description": "Dotted member path in the interface, for example `backgroundTasks.list`."
        },
        "optional": {
          "type": "boolean",
          "description": "The member is optional (`?`) or inside an optional group."
        },
        "synchronous": {
          "type": "boolean",
          "description": "The TypeScript member returns its value synchronously. Wire clients serve it from state they already hold and refresh it with this request."
        },
        "capability": {
          "type": "string",
          "description": "The capability path that gates this member. When it is off, the call rejects with `unsupported`."
        },
        "relatesTo": {
          "type": "string",
          "description": "For protocol helpers: the `Interface.member` they serve."
        },
        "params": {
          "$ref": "#/$defs/SchemaRef"
        },
        "result": {
          "$ref": "#/$defs/SchemaRef"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "stream": {
          "$ref": "#/$defs/MethodStream"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction",
        "kind",
        "params",
        "version"
      ]
    },
    "PropertyEntry": {
      "description": "Where a non-method member travels over the wire: inside the params or result of `method`, at JSON pointer `pointer`.",
      "type": "object",
      "properties": {
        "interface": {
          "$ref": "#/$defs/RuntimeInterface"
        },
        "member": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "location": {
          "enum": [
            "params",
            "result"
          ]
        },
        "pointer": {
          "type": "string"
        }
      },
      "required": [
        "interface",
        "member",
        "method",
        "location",
        "pointer"
      ]
    },
    "MethodTable": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "ariVersion": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodEntry"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyEntry"
          }
        }
      },
      "required": [
        "ariVersion",
        "methods",
        "properties"
      ]
    }
  }
}
