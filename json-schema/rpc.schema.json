{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.invalid/spec/v1/rpc.schema.json",
  "title": "ARI wire params and results",
  "description": "JSON-RPC params and results for the methods in methods.json. Mapping rules: a method's params are the TypeScript argument object plus the target id (`instanceId` or `sessionId`); positional TypeScript arguments become named fields; the result is the TypeScript return value, with `void` and `undefined` sent as `null`. Streams start with a request that returns `{ streamId }`; items arrive as notifications and the stream ends with `stream/end`.",
  "$defs": {
    "InstanceTarget": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        }
      },
      "required": [
        "instanceId"
      ]
    },
    "SessionTarget": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId"
      ]
    },
    "SessionThreadTarget": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "threadId"
      ]
    },
    "EmptyParams": {
      "type": "object"
    },
    "VoidResult": {
      "type": "null"
    },
    "BooleanResult": {
      "type": "boolean"
    },
    "StringResult": {
      "type": "string"
    },
    "NullableStringResult": {
      "type": [
        "string",
        "null"
      ]
    },
    "NullableIntegerResult": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "StreamStarted": {
      "type": "object",
      "properties": {
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId"
      ]
    },
    "StreamEndParams": {
      "description": "Ends a stream. `error` is set when it ended by failure.",
      "type": "object",
      "properties": {
        "streamId": {
          "type": "string"
        },
        "error": {
          "$ref": "errors.schema.json#/$defs/CallError"
        }
      },
      "required": [
        "streamId"
      ]
    },
    "StreamCancelParams": {
      "type": "object",
      "properties": {
        "streamId": {
          "type": "string"
        }
      },
      "required": [
