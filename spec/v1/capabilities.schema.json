{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.invalid/spec/v1/capabilities.schema.json",
  "title": "ARI capabilities",
  "description": "What a session's provider does natively. A driver reports only native behaviour; fallbacks belong to the host. A capability declared on that fails at runtime is a bug. Capabilities are emitted at session start and may change through `capabilities.updated`. A capability path is the dot-separated path to a field, for example `threads.fork.fromTurn`. A path is on when its value is `true`, an object whose `supported` is `true`, a non-empty array, or a string other than `none`; anything else, including a missing field, is off.",
  "$defs": {
    "SessionCapabilities": {
      "type": "object",
      "properties": {
        "multipleThreads": { "type": "boolean", "description": "One session can hold several provider threads." },
        "switchModel": { "type": "boolean", "description": "The model can change mid-session." },
        "switchRuntimeMode": { "type": "boolean", "description": "The runtime mode can change mid-session." },
        "pendingRequestsSurviveRestart": { "type": "boolean" },
        "release": { "type": "boolean", "description": "`release()` parks the runtime without losing threads." },
        "feedbackUpload": { "type": "boolean", "description": "Backs `uploadFeedback`." },
        "contextUsageReuse": { "type": "boolean", "description": "Backs `canReuseContextUsage`." }
      },
      "required": ["multipleThreads", "switchModel", "switchRuntimeMode", "pendingRequestsSurviveRestart", "release", "feedbackUpload", "contextUsageReuse"]
    },
    "ForkCapabilities": {
      "type": "object",
      "properties": {
        "supported": { "type": "boolean", "description": "Backs `forkThread` from the latest point." },
        "fromTurn": { "type": "boolean" },
        "fromItem": { "type": "boolean" },
        "fromSubagent": { "type": "boolean", "description": "A subagent's thread can be forked." },
        "crossCwd": { "type": "boolean", "description": "The fork may use a different working directory." }
      },
      "required": ["supported", "fromTurn", "fromItem", "fromSubagent", "crossCwd"]
    },
    "ThreadCapabilities": {
      "type": "object",
      "properties": {
        "createEmpty": { "type": "boolean", "description": "A thread exists before its first turn." },
        "readSnapshot": { "type": "boolean", "description": "Backs `readSnapshot`." },
        "rollback": { "type": "boolean", "description": "Backs `rollbackThread`." },
        "compact": { "type": "boolean", "description": "Backs `compactThread`." },
        "injectHistory": { "type": "boolean", "description": "Backs `injectHistory`." },
        "unload": { "type": "boolean", "description": "Backs `unloadThread`." },
        "exposesNativeIds": { "type": "boolean" },
        "fork": { "$ref": "#/$defs/ForkCapabilities" }
      },
      "required": ["createEmpty", "readSnapshot", "rollback", "compact", "injectHistory", "unload", "exposesNativeIds", "fork"]
    },
    "TurnCapabilities": {
      "type": "object",
      "properties": {
        "interrupt": { "type": "boolean" },
        "steer": { "type": "boolean", "description": "`startTurn` with `intent: \"steer\"` changes the active turn natively." },
        "queue": { "type": "boolean", "description": "`startTurn` with `intent: \"queue\"` queues natively." },
        "emitsStarted": { "type": "boolean" },
        "terminalStatus": { "$ref": "common.schema.json#/$defs/RefStrength", "description": "How reliable the provider's turn completion signal is." },
        "multiNativeTurnsPerRequest": { "type": "boolean", "description": "One host request can own several native turns, for example a goal run." },
        "steeringInterruptsTools": { "type": "boolean", "description": "Steering stops pending tool calls." }
      },
      "required": ["interrupt", "steer", "queue", "emitsStarted", "terminalStatus", "multiNativeTurnsPerRequest", "steeringInterruptsTools"]
    },
    "StreamingCapabilities": {
      "type": "object",
      "properties": {
        "assistantText": { "type": "boolean" },
        "reasoning": { "type": "boolean" },
        "toolOutput": { "type": "boolean" },
        "planText": { "type": "boolean" }
      },
      "required": ["assistantText", "reasoning", "toolOutput", "planText"]
    },
    "ToolCapabilities": {
      "type": "object",
      "properties": {
        "mcp": { "type": "boolean", "description": "The agent calls MCP tools." },
        "dynamicTools": { "type": "boolean", "description": "The agent calls host dynamic tools through `hostTools.callDynamicTool`." },
        "mcpApps": { "type": "boolean", "description": "Backs `mcpApps`." },
        "exposesToolItemIds": { "type": "boolean" }
      },
      "required": ["mcp", "dynamicTools", "mcpApps", "exposesToolItemIds"]
    },
    "ApprovalCapabilities": {
      "type": "object",
      "properties": {
        "command": { "type": "boolean" },
        "fileRead": { "type": "boolean" },
        "fileChange": { "type": "boolean" },
        "permission": { "type": "boolean" },
        "fromSubagents": { "type": "boolean" }
      },
      "required": ["command", "fileRead", "fileChange", "permission", "fromSubagents"]
    },
    "PlanningCapabilities": {
      "type": "object",
      "properties": {
        "todoList": { "type": "boolean" },
        "proposedPlan": { "type": "boolean" },
        "planUpdates": { "type": "boolean", "description": "Emits `plan.upsert`." },
        "structuredQuestions": { "type": "boolean" }
      },
      "required": ["todoList", "proposedPlan", "planUpdates", "structuredQuestions"]
    },
    "SubagentCapabilities": {
      "type": "object",
      "properties": {
        "supported": { "type": "boolean" },
        "exposesThreadIds": { "type": "boolean" },
        "lifecycle": { "type": "boolean", "description": "Emits `subagent.upsert` through the subagent's life." },
        "wait": { "type": "boolean" },
        "stop": { "type": "boolean", "description": "Backs `stopSubagent`." }
      },
      "required": ["supported", "exposesThreadIds", "lifecycle", "wait", "stop"]
    },
    "InstructionChannel": {
      "anyOf": [
        { "enum": ["system", "developer", "first_user_message"] },
        { "type": "string" }
      ]
    },
    "ContextCapabilities": {
      "type": "object",
      "properties": {
        "instructionChannels": {
          "type": "array",
          "items": { "$ref": "#/$defs/InstructionChannel" },
          "description": "Channels through which host instructions (`launch` and `context`) reach the agent."
        },
        "syntheticContext": { "type": "boolean", "description": "Accepts `context.synthetic` on `startTurn`." },
        "summaries": { "type": "boolean", "description": "The provider can generate conversation summaries." },
        "handoffSummaries": { "type": "boolean", "description": "Accepts a handoff summary through `injectHistory`." }
      },
      "required": ["instructionChannels", "syntheticContext", "summaries", "handoffSummaries"]
    },
    "CheckpointCapabilities": {
      "type": "object",
      "properties": {
        "workspace": { "type": "boolean", "description": "The provider can checkpoint workspace files natively (exposed through an extension)." },
        "conversationRollback": { "type": "boolean" },
        "rollbackReturnsSnapshot": { "type": "boolean" }
      },
      "required": ["workspace", "conversationRollback", "rollbackReturnsSnapshot"]
    },
    "IdentityCapabilities": {
      "type": "object",
      "properties": {
        "threadIds": { "$ref": "common.schema.json#/$defs/RefStrength" },
        "turnIds": { "$ref": "common.schema.json#/$defs/RefStrength" },
        "itemIds": { "$ref": "common.schema.json#/$defs/RefStrength" },
        "requestIds": { "$ref": "common.schema.json#/$defs/RefStrength" },
        "identityVersion": { "type": "integer", "minimum": 0, "description": "Bumped when the driver changes how it derives ids." }
      },
      "required": ["threadIds", "turnIds", "itemIds", "requestIds", "identityVersion"]
    },
    "PolicyEnforcement": {
      "description": "`native`: the provider enforces the mode. `client_boundary`: only the driver's replies to the provider enforce it.",
      "anyOf": [
        { "enum": ["native", "client_boundary"] },
        { "type": "string" }
      ]
    },
    "RuntimeModeSupport": {
      "type": "object",
      "properties": {
        "supported": { "type": "boolean" },
        "enforcement": { "$ref": "#/$defs/PolicyEnforcement" }
      },
      "required": ["supported", "enforcement"]
    },
    "RuntimePolicyCapabilities": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "object",
          "properties": {
            "read_only": { "$ref": "#/$defs/RuntimeModeSupport" },
            "approval_required": { "$ref": "#/$defs/RuntimeModeSupport" },
            "auto_accept_edits": { "$ref": "#/$defs/RuntimeModeSupport" },
            "auto": { "$ref": "#/$defs/RuntimeModeSupport" },
            "full_access": { "$ref": "#/$defs/RuntimeModeSupport" }
          },
          "required": ["read_only", "approval_required", "auto_accept_edits", "auto", "full_access"]
        },
        "interactionModes": { "type": "array", "items": { "$ref": "config.schema.json#/$defs/InteractionMode" } },
        "switchInSession": { "type": "boolean" }
      },
      "required": ["modes", "interactionModes", "switchInSession"]
    },
    "ApprovalScopeReach": {
      "description": "The real reach of one approval decision on this provider, for example `accept_always` reaching `project`.",
      "type": "object",
      "properties": {
        "decision": { "$ref": "request.schema.json#/$defs/ApprovalDecision" },
        "scope": { "$ref": "request.schema.json#/$defs/ApprovalScope" }
      },
      "required": ["decision", "scope"]
    },
    "RequestCapabilities": {
      "type": "object",
      "properties": {
        "responseModes": { "type": "array", "items": { "$ref": "request.schema.json#/$defs/ResponseMode" } },
        "allowCustomAnswer": { "type": "boolean" },
        "approvalScopes": { "type": "array", "items": { "$ref": "#/$defs/ApprovalScopeReach" } }
      },
      "required": ["responseModes", "allowCustomAnswer", "approvalScopes"]
    },
    "BackgroundCapabilities": {
      "type": "object",
      "properties": {
        "list": { "type": "boolean", "description": "Backs `backgroundTasks.list`." },
        "stop": { "type": "boolean", "description": "Backs `backgroundTasks.stop`." },
        "await": { "type": "boolean", "description": "Backs `backgroundTasks.await`." },
        "tasksEndWithProcess": { "type": "boolean", "description": "Background tasks die when the provider process exits." }
      },
      "required": ["list", "stop", "await", "tasksEndWithProcess"]
    },
    "McpTransport": {
      "anyOf": [
        { "enum": ["stdio", "http", "sse"] },
        { "type": "string" }
      ]
    },
    "McpScope": {
      "anyOf": [
        { "enum": ["thread", "directory", "session"] },
        { "type": "string" }
      ]
    },
    "McpCapabilities": {
      "type": "object",
      "properties": {
        "acceptsHostServers": { "type": "array", "items": { "$ref": "#/$defs/McpTransport" } },
        "scope": { "$ref": "#/$defs/McpScope", "description": "Where the provider registers MCP servers." }
      },
      "required": ["acceptsHostServers", "scope"]
    },
    "SessionModel": {
      "anyOf": [
        { "enum": ["in_process", "process_per_thread", "process_per_instance", "external"] },
        { "type": "string" }
      ]
    },
    "DiffCapabilities": {
      "type": "object",
      "properties": {
        "emits": { "type": "boolean", "description": "The provider reports file diffs." },
        "canDisable": { "type": "boolean", "description": "`openSession({ emitDiffs: false })` turns them off." }
      },
      "required": ["emits", "canDisable"]
    },
    "ExtensionDeclaration": {
      "type": "object",
      "properties": {
        "ns": { "type": "string", "description": "Extension namespace without the `x:` prefix, for example `codex.goal` or `ari.goal`." },
        "version": { "type": "string" }
      },
      "required": ["ns", "version"]
    },
    "Capabilities": {
      "description": "The 12 capability groups plus ARI's additions.",
      "type": "object",
      "properties": {
        "ariVersion": { "type": "string" },
        "sessions": { "$ref": "#/$defs/SessionCapabilities" },
        "threads": { "$ref": "#/$defs/ThreadCapabilities" },
        "turns": { "$ref": "#/$defs/TurnCapabilities" },
        "streaming": { "$ref": "#/$defs/StreamingCapabilities" },
        "tools": { "$ref": "#/$defs/ToolCapabilities" },
        "approvals": { "$ref": "#/$defs/ApprovalCapabilities" },
        "planning": { "$ref": "#/$defs/PlanningCapabilities" },
        "subagents": { "$ref": "#/$defs/SubagentCapabilities" },
        "context": { "$ref": "#/$defs/ContextCapabilities" },
        "checkpointing": { "$ref": "#/$defs/CheckpointCapabilities" },
        "identity": { "$ref": "#/$defs/IdentityCapabilities" },
        "runtimePolicy": { "$ref": "#/$defs/RuntimePolicyCapabilities" },
        "requests": { "$ref": "#/$defs/RequestCapabilities" },
        "background": { "$ref": "#/$defs/BackgroundCapabilities" },
        "mcp": { "$ref": "#/$defs/McpCapabilities" },
        "sessionModel": { "$ref": "#/$defs/SessionModel" },
        "externallyOwned": { "type": "boolean", "description": "The provider runtime belongs to someone else; `close()` never stops it." },
        "diffs": { "$ref": "#/$defs/DiffCapabilities" },
        "contextWindowReporting": { "type": "boolean", "description": "Backs `contextWindow`." },
        "extensions": { "type": "array", "items": { "$ref": "#/$defs/ExtensionDeclaration" } }
      },
      "required": [
        "ariVersion",
        "sessions",
        "threads",
        "turns",
        "streaming",
        "tools",
        "approvals",
        "planning",
        "subagents",
        "context",
        "checkpointing",
        "identity",
        "runtimePolicy",
        "requests",
        "background",
        "mcp",
        "sessionModel",
        "externallyOwned",
        "diffs",
        "contextWindowReporting",
        "extensions"
      ]
    }
  }
}
